          "query": "sorted = from(bucket: \"k6_summaries\")\n  |> range(start: -180d)\n  |> filter(fn: (r) => r._measurement == \"endpoint_summary\" and r.test_name == \"${test_name}\" and r.request_name =~ /^${endpoint:regex}$/)\n  |> filter(fn: (r) => r.env == \"${env}\")\n  |> rename(columns: {test_id: \"testid\", request_name: \"endpoint\"})\n  |> filter(fn: (r) => r._field == \"${pct}\")\n  |> group(columns: [\"endpoint\"])\n  |> sort(columns: [\"_time\"], desc: true)\n\nlast = sorted |> limit(n: 1) |> group() |> keep(columns: [\"endpoint\", \"_value\"]) |> rename(columns: {_value: \"last\"})\nbase = sorted |> limit(n: ${runs}, offset: 1) |> quantile(q: 0.5, method: \"exact_selector\") |> group() |> keep(columns: [\"endpoint\", \"_value\"]) |> rename(columns: {_value: \"median\"})\n\njoin(tables: {l: last, b: base}, on: [\"endpoint\"])\n  |> group()\n  |> map(fn: (r) => ({r with delta_pct: if r.median > 0.0 then (r.last - r.median) / r.median * 100.0 else 0.0}))\n  |> sort(columns: [\"endpoint\"])"
