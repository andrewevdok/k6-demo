    "list": [
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-k6"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"k6_summaries\", tag: \"env\", predicate: (r) => r._measurement == \"test_summary\", start: -180d)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "test_name",
        "label": "Test",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-k6"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"k6_summaries\", tag: \"test_name\", predicate: (r) => r._measurement == \"test_summary\" and r.env == \"${env}\", start: -180d)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-k6"
        },
        "query": "from(bucket: \"k6_summaries\")\n  |> range(start: -180d)\n  |> filter(fn: (r) => r._measurement == \"endpoint_summary\" and r.test_name == \"${test_name}\" and r._field == \"p95\")\n  |> filter(fn: (r) => r.env == \"${env}\")\n  |> rename(columns: {test_id: \"testid\", request_name: \"endpoint\"})\n  |> keep(columns: [\"endpoint\"])\n  |> group()\n  |> distinct(column: \"endpoint\")",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "allValue": ".*"
      },
      {
        "name": "runs",
        "label": "Number of runs",
        "type": "custom",
        "query": "5,10,20,30,50",
