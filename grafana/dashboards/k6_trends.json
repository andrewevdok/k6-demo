      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-k6"
          },
          "refId": "A",
          "query": "from(bucket: \"k6_summaries\")\n  |> range(start: -180d)\n  |> filter(fn: (r) => r._measurement == \"test_summary\" and r.test_name == \"${test_name}\")\n  |> filter(fn: (r) => r.env == \"${env}\")\n  |> rename(columns: {test_id: \"testid\"})\n  |> filter(fn: (r) => r._field =~ /^(min|avg|p90|p95|p99|max|testid)$/)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: ${runs})\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({r with run: 1}))\n  |> cumulativeSum(columns: [\"run\"])\n  |> drop(columns: [\"_time\"])"
        }
      ],
