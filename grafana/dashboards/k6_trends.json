          "query": "vals = from(bucket: \"k6_summaries\")\n  |> range(start: -180d)\n  |> filter(fn: (r) => r._measurement == \"endpoint_summary\" and r.test_name == \"${test_name}\" and r.request_name =~ /^${endpoint:regex}$/)\n  |> filter(fn: (r) => r.env == \"${env}\")\n  |> rename(columns: {test_id: \"testid\", request_name: \"endpoint\"})\n  |> filter(fn: (r) => r._field == \"${pct}\")\n  |> keep(columns: [\"_time\", \"endpoint\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"endpoint\"], valueColumn: \"_value\")\n\nids = from(bucket: \"k6_summaries\")\n  |> range(start: -180d)\n  |> filter(fn: (r) => r._measurement == \"endpoint_summary\" and r.test_name == \"${test_name}\" and r.request_name =~ /^${endpoint:regex}$/)\n  |> filter(fn: (r) => r.env == \"${env}\")\n  |> rename(columns: {test_id: \"testid\", request_name: \"endpoint\"})\n  |> filter(fn: (r) => r._field == \"requests\")\n  |> keep(columns: [\"_time\", \"testid\"])\n  |> group()\n  |> unique(column: \"testid\")\n\njoin(tables: {v: vals, i: ids}, on: [\"_time\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: ${runs})\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({r with run: 1}))\n  |> cumulativeSum(columns: [\"run\"])\n  |> drop(columns: [\"_time\"])"
